{
    "compilerOptions":  {
                            "target":  "ES2022",
                            "module":  "NodeNext",
                            "moduleResolution":  "NodeNext",
                            "rootDir":  "src",
                            "outDir":  "dist",
                            "strict":  true,
                            "noUncheckedIndexedAccess":  true,
                            "exactOptionalPropertyTypes":  true,
                            "sourceMap":  true,
                            "declaration":  true,
                            "declarationMap":  true,
                            "forceConsistentCasingInFileNames":  true,
                            "skipLibCheck":  true,
                            "types":  [
                                          "node"
                                      ]
                        },
    "include":  [
                    "src/**/*.ts"
                ]
}
